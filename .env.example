# Copy to .env and fill in. Never commit .env.

# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgres://tbe:tbe@localhost:5432/tbe

# Better Auth: random secret, at least 32 characters (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-random-secret-of-32-chars
# Public URL of the app (without trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Temporary sign-in allow-list until milestone 2 (comma separated)
AUTH_ALLOWED_EMAILS=
